# Copy to `.env` and fill in values:
#   cp .env.example .env
#
# Supabase: Project Settings → API (URL, anon/public key, service_role key).
# After DB setup, run: backend/sql/setup-hrms-database.sql in the SQL Editor.

# --- Server ---
PORT=5002
# NODE_ENV=development

# --- Auth (JWT for admin + employee portal API) ---
# Use a long random string in production (never commit the real secret).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Supabase (required) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public/anon key — required if SERVICE_ROLE is not set (not recommended for this API).
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only — recommended for Express so writes are not blocked by RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Optional fallbacks (same values as admin/hr-employee `.env.local`) ---
# If SUPABASE_URL / SUPABASE_ANON_KEY are unset, the backend reads these instead.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
